root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{js,jsx,ts,tsx}]
indent_size = 2
quote_type = double

[*.json]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.css]
indent_size = 2